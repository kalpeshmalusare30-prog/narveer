# Local development database.
# Autonomous build used a native PostgreSQL 17 cluster on port 5433 (trust auth).
# For Docker-based dev/deploy, use the docker-compose values instead:
#   postgresql://crm:crm@localhost:5432/mandal_crm?schema=public
DATABASE_URL="postgresql://crm:crm@localhost:5433/mandal_crm?schema=public"
DATABASE_URL_TEST="postgresql://crm:crm@localhost:5433/mandal_crm_test?schema=public"

# Auth.js (generate a real 32+ byte secret for production: `openssl rand -base64 32`)
AUTH_SECRET="change-me-to-a-32-byte-minimum-random-secret-string"
AUTH_URL="http://localhost:3000"

# File storage (local volume)
STORAGE_LOCAL_DIR="./uploads"
